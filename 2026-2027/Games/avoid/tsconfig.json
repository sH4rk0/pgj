{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "strictNullChecks": false,
    "allowUnreachableCode": true,
    "sourceMap": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@types", "typings"],
    "lib": ["dom", "es2020"],
  }
}